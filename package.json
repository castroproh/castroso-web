{
  "name": "castroso-static",
  "version": "1.0.0",
  "description": "CASTROSO.JPG - Sitio estático para GitHub Pages",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "BASE_PATH=/castroso-web/ SITE_URL=https://castroproh.github.io node scripts/build.mjs",
    "preview": "npx serve dist -p 3000",
    "dev": "BASE_PATH= SITE_URL=http://localhost:3000 node scripts/build.mjs && npx serve dist -p 3000"
  },
  "keywords": [
    "castroso",
    "static-site",
    "github-pages"
  ],
  "author": "CASTROSO.JPG",
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.0.0",
    "@fontsource-variable/sora": "^5.0.0",
    "serve": "^14.2.0",
    "sharp": "^0.35.5"
  }
}
